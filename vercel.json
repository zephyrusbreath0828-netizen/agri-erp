{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build/assemble.js --dist",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    { "source": "/api/config", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] }
  ]
}
